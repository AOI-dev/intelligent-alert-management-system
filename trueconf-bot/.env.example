# Secret-only. Copy to .env on the deployment host; deploy.sh never
# overwrites an existing .env.

# Register a chat bot in the TrueConf Server control panel (Chat bots
# section, server 5.5+/Enterprise/Free) to get this token. Distinct from
# both TRUECONF_OAUTH_CLIENT_SECRET (platform's end-user login app) and
# TRUECONF_ADMIN_API_TOKEN (platform's user-provisioning script).
TRUECONF_BOT_TOKEN=
