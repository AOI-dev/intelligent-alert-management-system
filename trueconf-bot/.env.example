# Secret-only. Copy to .env on the deployment host; deploy.sh never
# overwrites an existing .env.

# Register a chat bot in the TrueConf Server control panel (Chat bots
# section, server 5.5+/Enterprise/Free) to get this token. Distinct from
# both TRUECONF_OAUTH_CLIENT_SECRET (platform's end-user login app) and
# TRUECONF_ADMIN_API_TOKEN (platform's user-provisioning script).
TRUECONF_BOT_TOKEN=

# Fallback when the server has no chat-bot section in its control panel (this
# pilot's 5.5.5 build does not: the Chatbot API answers, but nothing can mint
# a token). The adapter then logs in as an ordinary TrueConf account and sends
# from it. Leave both blank if TRUECONF_BOT_TOKEN is set -- the token wins.
TRUECONF_BOT_USERNAME=
TRUECONF_BOT_PASSWORD=
