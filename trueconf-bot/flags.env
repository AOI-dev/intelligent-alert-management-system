# Non-secret runtime flags. Committed and deployed on every run.

# Same convention as platform/flags.env's TRUECONF_BASE_URL: the TrueConf
# Server host address (it's plain `docker run`, not on any named Docker
# network -- see trueconf/README.md), not a Docker service name.
TRUECONF_SERVER=161.104.107.172

# Host port for the incident-delivery endpoint (POST /v1/notify). Must match
# the webhook_url in platform/routing.json.
TRUECONF_BOT_PORT=8120

# Transport to the TrueConf Server. Not the library's defaults (https/443):
# this server publishes 443 but serves no TLS there -- HTTPS is terminated by
# trueconf-tls on 8443 with a self-signed cert, while plain HTTP on 80
# answers. Bot and server sit on the same host, so http/80 is the direct
# path; set TRUECONF_HTTPS=true, TRUECONF_WEB_PORT=8443 to go via the proxy
# instead, in which case TRUECONF_VERIFY_SSL must stay false.
TRUECONF_HTTPS=false
TRUECONF_WEB_PORT=80
TRUECONF_VERIFY_SSL=false
