# Non-secret runtime flags. This file is committed and deployed on every run.

NOTIFICATIONS_PORT=8110
KAFKA_BOOTSTRAP_SERVERS=eventsim-kafka:9092
KAFKA_NOTIFICATION_REQUESTS_TOPIC=monitoring.notification-requests.v1
KAFKA_NOTIFICATION_RESULTS_TOPIC=monitoring.notification-results.v1
KAFKA_CONSUMER_GROUP=notification-dispatcher-v1
NOTIFICATIONS_HISTORY_LIMIT=500
WEBHOOK_TIMEOUT_SECONDS=10
