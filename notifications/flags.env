# Non-secret runtime flags. This file is committed and deployed on every run.

# 8111, not the 8110 this stack was designed for: cmdb-service already holds
# 8110 on the VM (127.0.0.1:8110). cmdb is not part of this repo -- it was
# deployed straight onto the host -- so the port is moved here rather than
# disturbing a running service. Only /health, /v1/results and /metrics are
# served on it; the dispatcher's real inputs are Kafka, and Prometheus
# scrapes it over the shared network, not this port.
NOTIFICATIONS_PORT=8111
KAFKA_BOOTSTRAP_SERVERS=eventsim-kafka:9092
KAFKA_NOTIFICATION_REQUESTS_TOPIC=monitoring.notification-requests.v1
KAFKA_NOTIFICATION_RESULTS_TOPIC=monitoring.notification-results.v1
KAFKA_CONSUMER_GROUP=notification-dispatcher-v1
NOTIFICATIONS_HISTORY_LIMIT=500
WEBHOOK_TIMEOUT_SECONDS=10
