# Non-secret deployment settings. This file is committed and deployed on every
# push; put credentials only in the gitignored .env file.

MYSQL_DATABASE=zabbix
MYSQL_USER=zabbix

# Image tag applied to server, web and agent (keep them in lockstep).
ZABBIX_VERSION=7.0-alpine-latest

# Host port bindings
ZABBIX_WEB_PORT=8080
ZABBIX_SERVER_PORT=10051

# Frontend timezone, e.g. Europe/Kyiv
PHP_TZ=UTC

# Server tuning
ZBX_CACHESIZE=64M
ZBX_STARTPOLLERS=5

# Name the bundled agent registers itself as
ZBX_AGENT_HOSTNAME=Zabbix server
