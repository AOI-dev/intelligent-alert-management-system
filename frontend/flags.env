# Non-secret runtime flags. This file is committed and deployed on every run.

# 8090 collides with eventsim-server on the VM -- 8091 is free (checked
# against docker ps and ss -tlnp there before picking it).
FRONTEND_PORT=8091
# Docker DNS name:port of the platform stack's server container, reachable
# because this stack joins platform's own network (platform_platform) --
# see platform/docker-compose.yml's `platform` network entry.
PLATFORM_UPSTREAM=monitoring-platform:8100
