# Non-secret runtime flags. This file is committed and deployed on every run.

# 443 is already bound by trueconf-server's own (non-functional -- no TLS
# ever configured there, see README.md) HTTPS port mapping; 8443 avoids
# that collision. Checked free against the VM's other stacks before
# picking it.
TRUECONF_TLS_PORT=8443

# HTTPS front for monitoring-frontend, so the whole login flow is one
# scheme (see nginx.conf's :8543 server block). Checked free against the
# VM's other stacks before picking it.
FRONTEND_TLS_PORT=8543
