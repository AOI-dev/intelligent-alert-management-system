# Secrets only. Copy to .env (gen-env.sh does this with a random admin
# password); run.sh never overwrites an existing .env.

# Login for the container-local TrueConf Server admin account (not an OS
# user). Generated by gen-env.sh if left blank here.
TRUECONF_ADMIN_USER=tc_admin
TRUECONF_ADMIN_PASSWORD=

# Free registration key, minus the first 4-5 characters (see
# https://trueconf.com/blog/knowledge-base/how-to-renew-trueconf-server-free-license).
# Leave blank to activate later via the web control panel instead.
TRUECONF_SERIAL=
