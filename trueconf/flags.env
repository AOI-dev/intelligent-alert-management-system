# Non-secret runtime flags for the TrueConf Server container. Committed;
# read by run.sh. This stack is NOT deployed via scripts/deploy.sh/Compose —
# see README.md for why.

TRUECONF_IMAGE=trueconf/trueconf-server:stable
TRUECONF_CONTAINER_NAME=trueconf-server
TRUECONF_HTTP_PORT=80
TRUECONF_HTTPS_PORT=443
TRUECONF_PROTOCOL_PORT=4307
# WebRTC media range (53000-55000/udp) is intentionally NOT published: Docker's
# userland-proxy spawns one process per mapped port, and publishing ~2000 UDP
# ports crashed dockerd on first launch here. Browser/WebRTC participants
# won't get media without it; native TrueConf clients over 4307 still work.
TRUECONF_DATA_DIR=./data/lib
TRUECONF_LOG_DIR=./data/log
# /opt/trueconf/server/etc/webmanager is intentionally NOT bind-mounted: an
# empty host dir there hides the image's baked-in env.conf/*.conf and crash-
# loops the app ("Failed to initialize sql client"). Add a webmanager mount
# only after first copying the image's existing files out with `docker cp`.

# Set once you've registered a Free license (see README) — leave blank to
# activate later through the web control panel instead.
TRUECONF_SERVER_ID=
TRUECONF_SERVER_NAME=
