# No secrets required for the dead-simple MVP — Kafka runs unauthenticated
# on an internal bridge network only. Copy to .env if you want to override
# any default below.

EVENTSIM_PORT=8090
KAFKA_TOPIC=alerts
# Must be a valid base64-encoded 16-byte UUID (kafka-storage random-uuid).
KAFKA_CLUSTER_ID=iSvZo0OwTr6sRUMPCppRKA

# Set to true to have the server generate synthetic events on its own (handy
# before any real monitoring-system integration exists) instead of only
# reacting to POST /events.
EVENTSIM_AUTOGENERATE=false
EVENTSIM_AUTOGENERATE_INTERVAL=10
