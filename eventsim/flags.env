# Non-secret runtime flags. This file is committed and deployed on every push.
# Do not put credentials here; future credentials belong in gitignored .env.

EVENTSIM_PORT=8090
KAFKA_EVENTS_TOPIC=monitoring.events.v1
KAFKA_ALERTS_TOPIC=monitoring.alerts.v1
# Must be a valid base64-encoded 16-byte UUID (kafka-storage random-uuid).
KAFKA_CLUSTER_ID=iSvZo0OwTr6sRUMPCppRKA

# Synthetic traffic is enabled on deployment so the alert viewer stays useful
# before Zabbix and Prometheus integrations are implemented.
EVENTSIM_AUTOGENERATE=true
EVENTSIM_AUTOGENERATE_INTERVAL=10
