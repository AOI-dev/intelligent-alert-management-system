# Secret integration credentials only. Copy to .env on the deployment host.
# deploy.sh never overwrites an existing .env.

# Create a dedicated least-privilege API token in Zabbix and set it here.
ZABBIX_API_TOKEN=

# Full asyncpg URL for the timescaledb stack's `platform` database/user; the
# password must match timescaledb/.env's POSTGRES_PASSWORD.
IDENTITY_DATABASE_URL=postgresql+asyncpg://platform:CHANGE_ME@timescaledb:5432/platform

# Random secret used to sign the platform session cookie.
SESSION_SECRET_KEY=

# From the TrueConf Server control panel: API -> OAuth2 -> this app.
TRUECONF_OAUTH_CLIENT_SECRET=
