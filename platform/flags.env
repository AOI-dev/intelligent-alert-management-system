# Non-secret runtime flags. This file is committed and deployed on every run.

PLATFORM_PORT=8100
KAFKA_BOOTSTRAP_SERVERS=eventsim-kafka:9092
KAFKA_EVENTS_TOPIC=monitoring.events.v1
KAFKA_ALERTS_TOPIC=monitoring.alerts.v1
KAFKA_CONSUMER_GROUP=platform-ingestion-v1
KAFKA_AI_REQUESTS_TOPIC=monitoring.ai.enrichment.v1
KAFKA_AI_RESULTS_TOPIC=monitoring.ai.results.v1
PLATFORM_HISTORY_LIMIT=500
ZABBIX_API_URL=http://zabbix-web:8080/api_jsonrpc.php
ZABBIX_RECONCILE_INTERVAL=60

# Entrance rate limiting (app/core/rate_limit.py). Webhooks get their own,
# stricter budget since they're unauthenticated and machine-to-machine.
RATE_LIMIT_WEBHOOK_CAPACITY=60
RATE_LIMIT_WEBHOOK_REFILL_PER_SECOND=5
RATE_LIMIT_API_CAPACITY=120
RATE_LIMIT_API_REFILL_PER_SECOND=20

# Plugin extension points. Comma-separated dotted paths to plugin factories.
# See app/plugins/ports.py for the available extension points and
# app/plugins/examples/ for templates.
PLUGIN_PATHS=app.plugins.builtins.enrichment.IdentityEnricher,app.plugins.builtins.correlation.PassThroughCorrelator,app.plugins.builtins.execution.LoggingExecutor

# TrueConf OAuth2 (АР-07). Create the OAuth2 app under the TrueConf Server
# control panel at API -> OAuth2 first; it hands out the client_id this
# platform authenticates with (client_secret is a platform/.env secret).
TRUECONF_BASE_URL=http://161.104.107.172
TRUECONF_OAUTH_CLIENT_ID=
TRUECONF_OAUTH_REDIRECT_URI=http://161.104.107.172:8100/v1/auth/callback
# Verify against the deployed server's own /api/v4/docs/ before relying on
# these — TrueConf doesn't publish a fixed userinfo path/claim schema.
TRUECONF_USERINFO_PATH=/api/v4/users/self
TRUECONF_USERINFO_SUBJECT_FIELD=id
TRUECONF_USERINFO_DISPLAY_FIELD=displayName

# vLLM OpenAI-compatible inference server for the AI enrichment contour
# (app/ai/ -- currently reserved ports only, see README's "AI" section).
# Env variables only for now; no client code reads these yet. Secret
# VLLM_API_KEY lives in platform/.env, not here.
VLLM_BASE_URL=http://161.104.107.172:8000/v1
