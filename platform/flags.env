# Non-secret runtime flags. This file is committed and deployed on every run.

PLATFORM_PORT=8100
KAFKA_BOOTSTRAP_SERVERS=eventsim-kafka:9092
KAFKA_EVENTS_TOPIC=monitoring.events.v1
KAFKA_ALERTS_TOPIC=monitoring.alerts.v1
KAFKA_CONSUMER_GROUP=platform-ingestion-v1
KAFKA_AI_REQUESTS_TOPIC=monitoring.ai.enrichment.v1
KAFKA_AI_RESULTS_TOPIC=monitoring.ai.results.v1
PLATFORM_HISTORY_LIMIT=500
ZABBIX_API_URL=http://zabbix-web:8080/api_jsonrpc.php
ZABBIX_RECONCILE_INTERVAL=60

# Entrance rate limiting (app/core/rate_limit.py). Webhooks get their own,
# stricter budget since they're unauthenticated and machine-to-machine.
RATE_LIMIT_WEBHOOK_CAPACITY=60
RATE_LIMIT_WEBHOOK_REFILL_PER_SECOND=5
RATE_LIMIT_API_CAPACITY=120
RATE_LIMIT_API_REFILL_PER_SECOND=20

# TimescaleDB history projection (app/monitoring/persistence.py, АР-08).
# Retention per hypertable; decision_log defaults longer since it's the
# audit trail ("at least a year").
TIMESCALE_EVENT_RETENTION_DAYS=90
TIMESCALE_ALERT_RETENTION_DAYS=90
TIMESCALE_DECISION_RETENTION_DAYS=400

# Plugin extension points. Comma-separated dotted paths to plugin factories.
# See app/plugins/ports.py for the available extension points and
# app/plugins/examples/ for templates.
#
# FlapAwareCorrelatorPlugin (not PassThroughCorrelator) is the real default:
# it wraps app/core/correlation_automaton.py, the dedup/cascade-folding/flap
# suppression policy the core tests pin. With PassThroughCorrelator here,
# PluginEngine -- the engine app/main.py actually runs -- produced no
# decisions at all, and only the legacy correlation_engine routed anything.
# handle_alert deduplicates across the two engines, so running both with the
# same policy publishes each decision once.
PLUGIN_PATHS=app.plugins.builtins.enrichment.IdentityEnricher,app.plugins.builtins.correlation.FlapAwareCorrelatorPlugin,app.plugins.builtins.execution.LoggingExecutor

# TrueConf OAuth2 (АР-07). Create the OAuth2 app under the TrueConf Server
# control panel at API -> OAuth2 first; it hands out the client_id this
# platform authenticates with (client_secret is a platform/.env secret).
# HTTPS + the :8443 port: TrueConf Server's own /oauth2/authorize refuses
# plain HTTP ("Authorization requires HTTPS"); trueconf-server itself has
# no real TLS configured, so this goes through trueconf-tls/, a separate
# self-signed proxy in front of it (see that stack's README for why it's
# separate rather than adding TLS to trueconf-server directly).
TRUECONF_BASE_URL=https://161.104.107.172:8443
# trueconf-tls/'s cert is self-signed (no domain name for this VM -- see
# that stack's README) -- httpx would otherwise reject it outright, unlike
# a browser, which just shows a click-through warning. Never set this
# false against a real, publicly-trusted TrueConf deployment.
TRUECONF_VERIFY_SSL=false
TRUECONF_OAUTH_CLIENT_ID=0b31dfd87182ad8cf4aa93e8a8ed715498a3c392
# Served by trueconf-tls's nginx (which proxies this one path back to
# monitoring-platform:8100), not by this host:port directly. It has to sit
# on the same origin as TrueConf's login page or the SPA's final XHR is
# mixed-content-blocked and the flow ends at a bare callback URL with no
# code -- see trueconf-tls/README.md, "The callback has to live on the
# TrueConf origin". This value must match the redirect_uri registered for
# the OAuth2 app in TrueConf's control panel exactly.
TRUECONF_OAUTH_REDIRECT_URI=https://161.104.107.172:8443/v1/auth/callback
# Read live off the deployed 5.5 server (TrueConf doesn't publish a fixed
# userinfo path/claim schema). /api/v4/users/self is an *admin* endpoint --
# a user's own OAuth access token gets 403 from it. /api/v4/me is the one
# the server's own UI uses with a bearer token, and it nests the profile:
# {"user": {"id": …, "display_name": …}, "admin": …, "guest": …}, hence the
# dotted paths.
TRUECONF_USERINFO_PATH=/api/v4/me
TRUECONF_USERINFO_SUBJECT_FIELD=user.id
TRUECONF_USERINFO_DISPLAY_FIELD=user.display_name

# Bootstrap: grant "admin" to an identity provisioned while no admin
# exists yet. Every identity is otherwise provisioned as "viewer", and
# /v1/identities (the admin panel's own API) requires "admin" -- so
# without this nobody can ever hold the role and the panel is unreachable
# for everyone. Applies only while the platform has no admin at all, so it
# stops mattering the moment the first one exists; set it false once the
# admin roster is where you want it.
AUTH_BOOTSTRAP_FIRST_ADMIN=true

# Cross-origin login (app/identity/return_to.py): origins allowed to receive
# a portable session token via /v1/auth/login?return_to=<origin>, for a
# frontend that isn't on this same host (TrueConf's OAuth2 redirect_uri is
# fixed to this host, so a cookie set during /v1/auth/callback never reaches
# anywhere else -- see the module docstring for the full reasoning). Comma-
# separated exact origins, no trailing slash, no path.
AUTH_RETURN_TO_ALLOWLIST=http://localhost:8091,http://161.104.107.172:8091,https://161.104.107.172:8543

# vLLM OpenAI-compatible inference server for the AI enrichment contour
# (app/ai/ -- see README's "AI" section). Secret VLLM_API_KEY lives in
# platform/.env, not here. VLLM_MODEL is usually left unset: the client
# then asks the server what it serves (vLLM serves exactly one model) and
# follows a model swap without a redeploy.
VLLM_BASE_URL=http://161.104.107.172:8000/v1
# VLLM_MODEL=

# AI enrichment feature mode: off (default) | shadow | suggest | assisted.
# Anything but "off" makes handle_alert fire a detached enrichment task per
# accepted alert — results land on monitoring.ai.results.v1 and never touch
# the deterministic decision path. Keep this off until the core pipeline's
# behavior is validated on its own; "shadow"/"suggest"/"assisted" all behave
# identically today (results are recorded, not acted on), the distinction is
# for whoever consumes the results topic.
AI_ENRICHMENT_MODE=off
AI_ENRICHMENT_TIMEOUT_SECONDS=30

# Notification delivery (app/routing/). A `route` decision becomes a
# NotificationRequest addressed at whoever ROUTING_CONFIG_PATH says is on
# call, and the notifications stack POSTs it to that target's webhook_url --
# trueconf-bot's /v1/notify, which turns it into a TrueConf direct message.
#
# Off by default: this is the only part of the pipeline that reaches a human,
# so it stays off until routing.json has been reviewed on the deployment host.
# routing.json is gitignored (it names real people); copy routing.example.json
# or generate one with scripts/routing_from_corpus.py.
NOTIFICATIONS_ENABLED=false
ROUTING_CONFIG_PATH=routing.json
# Concurrent notification builds. Each may call the model, and vLLM serves a
# fixed number of slots -- a storm must not open one completion per alert.
NOTIFICATION_CONCURRENCY=4

# Where a login that carried no return_to of its own lands. Needed because
# the OAuth2 callback is served from TrueConf's origin (see
# trueconf-tls/README.md): a relative redirect would resolve against
# TrueConf's root and land on its 404 page. Must also appear in
# AUTH_RETURN_TO_ALLOWLIST above -- it's validated like any other
# return_to, not trusted for being configured here.
AUTH_DEFAULT_RETURN_TO=https://161.104.107.172:8543
